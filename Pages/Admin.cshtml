@page
@model LibRecord.Pages.AdminModel
@{
  ViewData["Title"] = "Settings";
}

<section class="panel">
  <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:16px;">
    <div>
      <h1 class="h1">Settings</h1>
      <p class="muted">Localhost-only settings panel.</p>
    </div>
    @if (Model.IsAdmin)
    {
      <form method="post" asp-page-handler="Logout">
        <button class="btn" type="submit">Logout</button>
      </form>
    }
  </div>

  @if (!string.IsNullOrWhiteSpace(Model.Error))
  {
    <div class="divider"></div>
    <div class="panel" style="border-color: rgba(255,107,107,0.35); background: rgba(255,107,107,0.08);">
      <strong>Error:</strong> @Model.Error
    </div>
  }

  @if (!Model.IsAdmin)
  {
    <div class="divider"></div>
    <form method="post" asp-page-handler="Login" class="grid" style="max-width: 420px;">
      <div class="field">
        <label for="pw">Admin password</label>
        <input id="pw" type="password" asp-for="Password" />
      </div>
      <button class="btn btn--primary" type="submit">Enter</button>
    </form>
  }
</section>

@if (Model.IsAdmin)
{
  <div class="divider"></div>

  <div class="row row--2">
    <section class="panel">
      <h2 class="h1">Custom fields</h2>
      <p class="muted">Create up to your configured max (default 6). Mark which fields are searchable.</p>

      <form method="post" asp-page-handler="AddField" class="grid" style="margin-top: 12px;">
        <div class="field">
          <label>Field name</label>
          <input type="text" asp-for="NewFieldName" placeholder="e.g. Title, Author, Volume..." />
        </div>

        <div class="row row--2" style="gap: 12px;">
          <div class="field">
            <label>Type</label>
            <select asp-for="NewFieldType">
              <option value="@FieldType.Text">Text</option>
              <option value="@FieldType.Number">Number</option>
              <option value="@FieldType.Boolean">Boolean</option>
              <option value="@FieldType.Date">Date</option>
            </select>
          </div>
          <div class="grid">
            <label style="margin-bottom: 6px;">Options</label>
            <div class="actions">
              <label class="pill"><input type="checkbox" asp-for="NewFieldRequired" /> Required</label>
              <label class="pill"><input type="checkbox" asp-for="NewFieldSearchable" /> Searchable</label>
              <label class="pill"><input type="checkbox" asp-for="NewFieldFilterable" /> Filter</label>
              <label class="pill"><input type="checkbox" asp-for="NewFieldKeywords" /> Keywords</label>
            </div>
          </div>
        </div>

        <button class="btn btn--primary" type="submit">Add field</button>
      </form>

      <div class="divider"></div>

      <table class="table">
        <thead>
          <tr>
            <th style="width:50px;">#</th>
            <th>Name</th>
            <th>Type</th>
            <th>Flags</th>
            <th style="width: 220px;">Actions</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var f in Model.Fields.OrderBy(x => x.IsDeleted).ThenBy(x => x.SortOrder))
          {
            <tr>
              <td><span class="pill">@f.SortOrder</span></td>
              <td>
                <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                  <span style="font-weight:700;">@f.Name</span>
                  @if (f.IsDeleted) { <span class="pill">deleted</span> }
                </div>

                @if (!f.IsDeleted)
                {
                  <form method="post" asp-page-handler="RenameField" style="margin-top:8px; display:flex; gap:8px; align-items:center;">
                    <input type="hidden" name="id" value="@f.Id" />
                    <input type="text" name="name" value="@f.Name" style="max-width: 260px;" />
                    <button class="btn" type="submit">Save</button>
                  </form>
                }
              </td>
              <td class="muted">@f.Type</td>
              <td class="muted">
                @if (f.IsRequired) { <span class="pill">required</span> }
                @if (f.IsSearchable) { <span class="pill">search</span> }
                @if (f.IsFilterable) { <span class="pill">filter</span> }
                @if (f.IsKeywords) { <span class="pill" title="Comma-separated values used for keyword search">Kw</span> }
              </td>
              <td>
                <div class="actions">
                  @if (!f.IsDeleted)
                  {
                    <form method="post" asp-page-handler="MoveField">
                      <input type="hidden" name="id" value="@f.Id" />
                      <input type="hidden" name="dir" value="up" />
                      <button class="btn" type="submit">Up</button>
                    </form>
                    <form method="post" asp-page-handler="MoveField">
                      <input type="hidden" name="id" value="@f.Id" />
                      <input type="hidden" name="dir" value="down" />
                      <button class="btn" type="submit">Down</button>
                    </form>
                    <form method="post" asp-page-handler="ToggleField">
                      <input type="hidden" name="id" value="@f.Id" />
                      <input type="hidden" name="prop" value="required" />
                      <button class="@(f.IsRequired ? "btn btn--primary" : "btn")" type="submit">Req</button>
                    </form>
                    <form method="post" asp-page-handler="ToggleField">
                      <input type="hidden" name="id" value="@f.Id" />
                      <input type="hidden" name="prop" value="searchable" />
                      <button class="@(f.IsSearchable ? "btn btn--primary" : "btn")" type="submit">Search</button>
                    </form>
                    <form method="post" asp-page-handler="ToggleField">
                      <input type="hidden" name="id" value="@f.Id" />
                      <input type="hidden" name="prop" value="filterable" />
                      <button class="@(f.IsFilterable ? "btn btn--primary" : "btn")" type="submit">Filter</button>
                    </form>
                    <form method="post" asp-page-handler="ToggleField">
                      <input type="hidden" name="id" value="@f.Id" />
                      <input type="hidden" name="prop" value="keywords" />
                      <button class="@(f.IsKeywords ? "btn btn--primary" : "btn")" type="submit">Kw</button>
                    </form>
                    <form method="post" asp-page-handler="ToggleField">
                      <input type="hidden" name="id" value="@f.Id" />
                      <input type="hidden" name="prop" value="delete" />
                      <button class="btn btn--danger" type="submit">Delete</button>
                    </form>
                  }
                  else
                  {
                    <form method="post" asp-page-handler="ToggleField">
                      <input type="hidden" name="id" value="@f.Id" />
                      <input type="hidden" name="prop" value="restore" />
                      <button class="btn" type="submit">Restore</button>
                    </form>
                  }
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </section>

    <section class="panel">
      <h2 class="h1">@((Model.EditBookId is null) ? "Add book" : $"Edit book #{Model.EditBookId}")</h2>
      <p class="muted">This form is generated from your current custom fields.</p>

      <form method="post" asp-page-handler="SaveBook" class="grid" style="margin-top: 12px;">
        <input type="hidden" name="id" value="@(Model.EditBookId ?? 0)" />

        @{
          var activeFields = Model.Fields.Where(f => !f.IsDeleted).OrderBy(f => f.SortOrder).ToList();
        }

        @foreach (var f in activeFields)
        {
          var inputName = $"Value_{f.Id}";
          Model.EditFieldValues.TryGetValue(f.Id, out var cur);
          cur ??= "";
          <div class="field">
            <label>@f.Name @if (f.IsRequired) { <span class="pill">required</span> } @if (f.IsSearchable) { <span class="pill">search</span> } @if (f.IsKeywords) { <span class="pill" title="Comma-separated values are split for keyword search">Kw</span> }</label>
            @switch (f.Type)
            {
              case FieldType.Text:
                @if (f.IsKeywords)
                {
                  <textarea name="@inputName" rows="3" placeholder="Comma-separated, e.g. Development, Software, Management, Database">@cur</textarea>
                }
                else
                {
                  <input type="text" name="@inputName" value="@cur" />
                }
                break;
              case FieldType.Number:
                <input type="number" step="any" name="@inputName" value="@cur" />
                break;
              case FieldType.Boolean:
                <label class="pill" style="width: fit-content;">
                  <input type="checkbox" name="@inputName" value="true" checked="@(cur == "true" ? "checked" : null)" /> True
                </label>
                break;
              case FieldType.Date:
                <input type="date" name="@inputName" value="@cur" />
                break;
            }
          </div>
        }

        <div class="actions">
          <button class="btn btn--primary" type="submit">Save</button>
          <a class="btn" asp-page="/Admin">Reset</a>
        </div>
      </form>
    </section>
  </div>

  <div class="divider"></div>

  <section class="panel">
    <h2 class="h1">Books (@Model.Books.Count)</h2>
    <form method="get" class="grid" style="margin-top: 12px;">
      <div class="actions">
        <button class="btn" type="button" data-open-dialog="adminFiltersDialog">Filters & sort</button>
        <button class="btn btn--primary" type="submit">Apply</button>
        <a class="btn" asp-page="/Admin">Clear</a>
      </div>

      <dialog id="adminFiltersDialog" class="dialog">
        <div class="dialog__panel">
          <div style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
            <div style="font-weight:700;">Filters & sort</div>
            <button class="btn" type="button" data-close-dialog>Close</button>
          </div>

          <div class="divider"></div>

          <div class="row row--2" style="gap: 12px;">
            <div class="field">
              <label>Uploaded from</label>
              <input type="date" name="UploadedFrom" value="@(Model.UploadedFrom?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="field">
              <label>Uploaded to</label>
              <input type="date" name="UploadedTo" value="@(Model.UploadedTo?.ToString("yyyy-MM-dd"))" />
            </div>
          </div>

          <div class="divider"></div>

          <div class="field">
            <label>Sort (single choice)</label>
            <div class="grid" style="grid-template-columns: 1fr; gap: 8px;">
              <label class="pill"><input type="radio" name="Sort" value="" checked="@(string.IsNullOrWhiteSpace(Model.Sort) ? "checked" : null)" /> Uploaded (newest)</label>
              <label class="pill"><input type="radio" name="Sort" value="uploaded_old" checked="@(Model.Sort == "uploaded_old" ? "checked" : null)" /> Uploaded (oldest)</label>
              <label class="pill"><input type="radio" name="Sort" value="title_az" checked="@(Model.Sort == "title_az" ? "checked" : null)" /> Title (A-Z)</label>
              <label class="pill"><input type="radio" name="Sort" value="title_za" checked="@(Model.Sort == "title_za" ? "checked" : null)" /> Title (Z-A)</label>
            </div>
          </div>

          @foreach (var ff in Model.FilterFields)
          {
            var key = $"f_{ff.Field.Id}";
            Model.ActiveFilters.TryGetValue(ff.Field.Id, out var selectedSet);

            <div class="divider"></div>
            <div class="field">
              <label>@ff.Field.Name (multi-select)</label>
              <div class="actions">
                @foreach (var opt in ff.Options)
                {
                  var isChecked = selectedSet is not null && selectedSet.Contains(opt);
                  <label class="pill">
                    <input type="checkbox" name="@key" value="@opt" checked="@(isChecked ? "checked" : null)" />
                    @opt
                  </label>
                }
              </div>
            </div>
          }

          <div class="divider"></div>

          <div class="actions">
            <button class="btn btn--primary" type="submit" data-close-dialog>Apply</button>
            <a class="btn" asp-page="/Admin">Clear</a>
          </div>
        </div>
      </dialog>
    </form>

    @if (Model.Books.Count == 0)
    {
      <p class="muted">No books yet.</p>
    }
    else
    {
      <table class="table">
        <thead>
          <tr>
            <th style="width:60px;">ID</th>
            <th>Title</th>
            <th>Values</th>
            <th style="width:140px;">Actions</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var b in Model.Books)
          {
            <tr>
              <td><span class="pill">@b.Id</span></td>
              <td style="font-weight:700;">@b.Title</td>
              <td class="muted">
                @foreach (var v in b.Values.Take(6))
                {
                  <div><span class="muted">@v.Name</span>: @v.Value</div>
                }
              </td>
              <td>
                <div class="actions">
                  <a class="btn" asp-page="/Admin" asp-route-EditBookId="@b.Id">Edit</a>
                  <form method="post" asp-page-handler="DeleteBook">
                    <input type="hidden" name="id" value="@b.Id" />
                    <button class="btn btn--danger" type="submit">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    }
  </section>
}

