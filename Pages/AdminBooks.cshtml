@page
@model LibRecord.Pages.AdminBooksModel
@{
  ViewData["Title"] = "Admin books";
  ViewData["AdminNav"] = "add";
}

<section class="panel">
  <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:16px;">
    <div>
      <h1 class="h1">Admin · Books</h1>
      <p class="muted">Localhost-only. Password is in <code>appsettings.json</code>.</p>
    </div>
    @if (Model.IsAdmin)
    {
      <form method="post" asp-page-handler="Logout">
        <button class="btn" type="submit">Logout</button>
      </form>
    }
  </div>

  @if (!string.IsNullOrWhiteSpace(Model.Error))
  {
    <div class="divider"></div>
    <div class="panel" style="border-color: rgba(255,107,107,0.35); background: rgba(255,107,107,0.08);">
      <strong>Error:</strong> @Model.Error
    </div>
  }

  @if (!Model.IsAdmin)
  {
    <div class="divider"></div>
    <form method="post" asp-page-handler="Login" class="grid" style="max-width: 420px;">
      <div class="field">
        <label for="pw">Admin password</label>
        <input id="pw" type="password" asp-for="Password" />
      </div>
      <button class="btn btn--primary" type="submit">Enter</button>
    </form>
  }
</section>

@if (Model.IsAdmin)
{
  <div class="divider"></div>

  <div class="admin-shell">
    <aside class="panel" style="padding: 12px;">
      <div style="font-weight:700; margin-bottom: 10px;">Admin</div>
      <partial name="Shared/_AdminSidebar" />
    </aside>

    <section class="panel">
      <h2 class="h1">@((Model.EditBookId is null) ? "Add book" : $"Edit book #{Model.EditBookId}")</h2>
      <p class="muted">This form is generated from your current custom fields.</p>

      <form method="post" asp-page-handler="SaveBook" class="grid" style="margin-top: 12px;">
        <input type="hidden" name="id" value="@(Model.EditBookId ?? 0)" />

        @{
          var activeFields = Model.Fields.Where(f => !f.IsDeleted).OrderBy(f => f.SortOrder).ToList();
        }

        @foreach (var f in activeFields)
        {
          var inputName = $"Value_{f.Id}";
          Model.EditFieldValues.TryGetValue(f.Id, out var cur);
          cur ??= "";
          <div class="field">
            <label>@f.Name @if (f.IsRequired) { <span class="pill">required</span> } @if (f.IsSearchable) { <span class="pill">search</span> } @if (f.IsKeywords) { <span class="pill" title="Comma-separated values are split for keyword search">Kw</span> }</label>
            @switch (f.Type)
            {
              case FieldType.Text:
                @if (f.IsKeywords)
                {
                  <textarea name="@inputName" rows="3" placeholder="Comma-separated, e.g. Development, Software, Management, Database">@cur</textarea>
                }
                else
                {
                  <input type="text" name="@inputName" value="@cur" />
                }
                break;
              case FieldType.Number:
                <input type="number" step="any" name="@inputName" value="@cur" />
                break;
              case FieldType.Boolean:
                <label class="pill" style="width: fit-content;">
                  <input type="checkbox" name="@inputName" value="true" checked="@(cur == "true" ? "checked" : null)" /> True
                </label>
                break;
              case FieldType.Date:
                <input type="date" name="@inputName" value="@cur" />
                break;
            }
          </div>
        }

        <div class="actions">
          <button class="btn btn--primary" type="submit">Save</button>
          <a class="btn" asp-page="/AdminBooks">Reset</a>
        </div>
      </form>
    </section>
  </div>
}

