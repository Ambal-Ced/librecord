@{
  var active = (ViewData["AdminNav"] as string) ?? "";
  string LinkClass(string key) => key == active ? "admin-nav__link admin-nav__link--active" : "admin-nav__link";
}

<nav class="admin-nav">
  <a class="@LinkClass("add")" asp-page="/AdminBooks">Add books</a>
  <a class="@LinkClass("fields")" asp-page="/AdminFields">Fields</a>
  <a class="@LinkClass("books")" asp-page="/AdminList">Books</a>
  <a class="@LinkClass("resource")" asp-page="/ResourceBooks">Resource Excel</a>
</nav>

