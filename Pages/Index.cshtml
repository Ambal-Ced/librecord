@page
@model LibRecord.Pages.IndexModel
@{
  ViewData["Title"] = "Main";
}

<div class="row row--2">
  <section class="panel">
    <h1 class="h1">Search books</h1>
    <p class="muted">Search looks at fields marked as searchable in Admin.</p>
    <form method="get" class="grid" style="margin-top: 12px;">
      <div class="field">
        <label for="q">Search</label>
        <input id="q" name="q" type="text" value="@Model.Query" placeholder="Try: calculus, author name, keywords…" />
      </div>
      <div class="actions">
        <button class="btn btn--primary" type="submit">Search</button>
        <a class="btn" asp-page="/Index">Clear</a>
      </div>
    </form>
  </section>

  <section class="panel">
    <h2 class="h1">Related books</h2>
    @if (string.IsNullOrWhiteSpace(Model.Query))
    {
      <p class="muted">Search first to see related books.</p>
    }
    else if (Model.Related.Count == 0)
    {
      <p class="muted">No related matches yet.</p>
    }
    else
    {
      <div class="grid">
        @foreach (var book in Model.Related)
        {
          <div class="panel" style="padding: 12px;">
            <div style="display:flex; align-items:center; justify-content:space-between; gap:10px;">
              <div style="font-weight:700;">@book.Title</div>
              <span class="pill">#@book.Id</span>
            </div>
            @if (book.Lines.Count > 0)
            {
              <div class="muted" style="margin-top:6px; font-size: 13px;">
                @foreach (var line in book.Lines)
                {
                  <div><span class="muted">@line.Name</span>: @line.Value</div>
                }
              </div>
            }
          </div>
        }
      </div>
    }
  </section>
</div>

<div class="divider"></div>

<section class="panel">
  <h2 class="h1">Results (@Model.Results.Count)</h2>
  @if (Model.Results.Count == 0)
  {
    <p class="muted">No books found.</p>
  }
  else
  {
    <table class="table">
      <thead>
        <tr>
          <th style="width: 50px;">ID</th>
          <th>Title</th>
          <th>Details</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var book in Model.Results)
        {
          <tr>
            <td><span class="pill">@book.Id</span></td>
            <td style="font-weight:700;">@book.Title</td>
            <td class="muted">
              @if (book.Lines.Count == 0)
              {
                <span class="muted">—</span>
              }
              else
              {
                @foreach (var line in book.Lines)
                {
                  <div><span class="muted">@line.Name</span>: @line.Value</div>
                }
              }
            </td>
          </tr>
        }
      </tbody>
    </table>
  }
</section>

