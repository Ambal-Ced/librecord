{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LibRecord",
  "version": "1.2.0",
  "identifier": "com.librecord.app",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "npm run prepare:sidecar -- -Configuration Debug",
    "beforeBuildCommand": "npm run prepare:sidecar -- -Configuration Release"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LibRecord",
        "width": 1280,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/server"
    ]
  }
}

